{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "/api/chat?path=:path*"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/delete-account.html",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
