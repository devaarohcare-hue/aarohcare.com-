{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/chat/:phone(\\d{10,15})",
      "destination": "https://wa.me/:phone",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/delete-account.html",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
